# PostgreSQL connection
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pufa
DB_USERNAME=pufa
DB_PASSWORD=secret

# App configuration
APP_PORT=3000
APP_ENV=production
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRATION=1d

# Optional email / uploads configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=password
# SMTP_FROM="Pufa Backend <noreply@example.com>"
# SMTP_ADMIN_TO=admin@example.com

# Optional file upload destination inside container
# UPLOAD_DEST=./uploads
